<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashline's garage button. Reads and taps controls only inside the myQ app (packageNames), so
  it can find myQ's door button and its "Open for 5 minutes" status text.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:description="@string/dash_garage_description"
    android:notificationTimeout="200"
    android:packageNames="com.chamberlain.android.liftmaster.myq,com.google.android.googlequicksearchbox,com.google.android.apps.bard" />
